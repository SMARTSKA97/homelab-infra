# Global System Configurations
TZ=Asia/Kolkata
PUID=1000
PGID=1000

# Utility Exposed Application Ports
DOZZLE_PORT=8888
STIRLING_PORT=8083
IT_TOOLS_PORT=8084
QBITTORRENT_PORT=8085
PAPERLESS_PORT=8010

# Torrent Network Ports
QBIT_TORRENT_PORT=6881

# Paperless Secret Encryption Key (Change this locally!)
PAPERLESS_SECRET_KEY=get_from_initial_logs

# External Dev-Backend Connection Settings
PAPERLESS_DB_HOST=your_secured_host
PAPERLESS_DB_PORT=5432
PAPERLESS_DB_NAME=your_database_name
PAPERLESS_DB_USER=your_database_user
PAPERLESS_DB_PASS=your_database_password
PAPERLESS_REDIS_URL=redis://redis_cache:6379
